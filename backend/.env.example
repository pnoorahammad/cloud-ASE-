# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_session_token_for_validation_rule_manager
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Salesforce Connected App Configuration
# Callback MUST point to the BACKEND (not the React app)
SF_CLIENT_ID=your_salesforce_connected_app_client_id
SF_CLIENT_SECRET=your_salesforce_connected_app_client_secret
SF_REDIRECT_URI=http://localhost:5000/auth/callback
SF_LOGIN_URL=https://login.salesforce.com

# Redis (optional locally — omit REDIS_URL to use in-memory store in development)
REDIS_URL=redis://localhost:6379
REDIS_EMULATE=true

# Database (Optional: If left blank, server falls back to local JSON file logging)
MONGO_URI=mongodb://localhost:27017/salesforce-rule-manager

# Simulation Mode (Set to true to run with mock data without Salesforce credentials)
SF_SIMULATION_MODE=false
